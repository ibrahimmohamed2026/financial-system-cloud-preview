# ===== قاعدة البيانات النشطة: PostgreSQL (أو SQLite عبر DATABASE_URL صريح) =====
# اترك DATABASE_URL فاضي لاستخدام POSTGRES_* (لو اتملى بيتغلّب على POSTGRES_*، مثال:
#   DATABASE_URL=postgresql+psycopg://user:pass@127.0.0.1:5432/financial_system )
DATABASE_URL=
POSTGRES_USER=financial_user
POSTGRES_PASSWORD=ضع_كلمة_مرور_قوية
POSTGRES_DB=financial_system
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# ولّد قيمة عشوائية:  python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=ضع_قيمة_عشوائية_طويلة_لا_تقل_عن_24_حرفاً
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
# الواجهة بتتقدم من نفس السيرفر فمش محتاج CORS إلا لو شغّلتها من مكان تاني
CORS_ORIGINS=
# Set only when deployed behind a reverse proxy; list trusted proxy IPs/CIDRs, never all clients.
TRUSTED_PROXY_IPS=
AUTH_RATE_LIMIT_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
# Keep API documentation disabled in production unless explicitly needed.
API_DOCS_ENABLED=false

# ===== النسخ الاحتياطي =====
BACKUP_DIR=./backups
# النسخ اليومي التلقائي داخل التطبيق (خليه false لو بتستخدم Task Scheduler مع scripts/daily_backup.py)
BACKUP_AUTO_ENABLED=true
BACKUP_TIME=02:00
BACKUP_RETENTION=14

# PostgreSQL pg_dump backups (automatic every 6 hours; keep 14 days)
PG_BACKUP_INTERVAL_HOURS=6
PG_BACKUP_RETENTION_DAYS=14
# Optional: full path to pg_dump.exe on Windows
# PG_DUMP_PATH=C:\Program Files\PostgreSQL\16\bin\pg_dump.exe
